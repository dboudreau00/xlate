# Copy to /etc/xlate.env, chmod 0600, and replace both values.
#
#   sudo install -m 0600 -o root -g root xlate.env.example /etc/xlate.env
#
# Generate a token:  openssl rand -hex 32
#
# Kept out of the unit file and off the command line so it does not appear
# in `ps` output or in the journal.

# Control-plane credential. Without it xlate generates one per run and
# prints it at startup — fine for a first look, wrong for a service that
# restarts.
XLATE_ADMIN_TOKEN=replace-me-with-openssl-rand-hex-32

# HMAC key for X-Xlate-Signature on tripwire alerts. An unsigned webhook
# is spoofable, which defeats the point of a security signal.
XLATE_ALERT_SECRET=replace-me-with-a-different-random-value
